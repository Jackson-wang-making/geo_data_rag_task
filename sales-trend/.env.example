# PostgreSQL connection used by the ETL and API.
POSTGRES_DB=sales_trend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/sales_trend

# ETL input. The filename may contain Chinese characters.
WORKBOOK_PATH=/app/data/sample_sales.xlsx
WORKBOOK_SHEET=sample_sales_data
SQL_DIR=/app/sql

# FastAPI listener.
API_PORT=8000