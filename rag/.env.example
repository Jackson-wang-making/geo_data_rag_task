# 复制为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交真实密钥。

# --- Embedding：本地 sentence-transformers bge-m3（默认，1024 维） ---
# 模型目录需要包含 config.json / modules.json / tokenizer 文件 / 权重文件。
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODEL_PATH=./data/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
# 也可用绝对路径，例如：
# EMBEDDING_MODEL_PATH=D:/ai_models/modelscope_cache/models/BAAI/bge-m3

# 可选：Docker Ollama。需要先启动 ollama/ollama 容器并拉取 bge-m3。
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# EMBEDDING_TIMEOUT=120

# --- 写作 LLM：DeepSeek OpenAI-compatible ---
# 密钥只放在本地 .env；不写入日志，不提交。
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=16000
VERIFIER_MAX_TOKENS=4000
LLM_TIMEOUT=300

# --- Chunk / 检索 / 上下文 ---
CHUNK_SIZE_CHARS=700
CHUNK_OVERLAP_CHARS=100
RETRIEVAL_TOP_K=10
MIN_DENSE_SCORE=0.35
MAX_CONTEXT_CHARS=10000
CITATION_MIN_OVERLAP=0.20

# --- OCR（可选；需安装 Tesseract 及 chi_sim 语言包） ---
OCR_LANGUAGES=chi_sim+eng
# TESSDATA_PREFIX=C:/Program Files/Tesseract-OCR/tessdata
